[Unit]
Description=OpenVibe.Exchange — trade what people make.
# Network (sign-in, JWKS, account events) should be up first, but Exchange degrades honestly without it: the public
# pages and API serve, and sign-in and the guarded routes wait for the signing key (see /api/ready).
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=openvibe-network.service postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.exchange
EnvironmentFile=/etc/openvibe/exchange.env
Environment=NODE_ENV=production
Environment=PORT=5150
Environment=HOST=127.0.0.1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.exchange/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
# In-flight requests get the 10 s drain.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# OpenVibe.Exchange's own database is PostgreSQL on the host's data role; the code tree stays read-only.

[Install]
WantedBy=multi-user.target
